{
  "name": "@araketski/nx-pi",
  "version": "0.0.1",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.map",
    "generators.json"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nx/devkit": "catalog:",
    "tslib": "catalog:",
    "validate-npm-package-name": "catalog:"
  },
  "devDependencies": {
    "@types/validate-npm-package-name": "catalog:"
  },
  "peerDependencies": {
    "nx": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=26.0.0 <27"
  },
  "generators": "./generators.json"
}
